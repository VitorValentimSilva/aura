{
  "name": "aura-database",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "prisma generate",
    "db:push:development": "dotenv -e ../../.env.development -- prisma db push",
    "db:push:production": "dotenv -e ../../.env.production -- prisma db push",
    "db:migrate:development": "dotenv -e ../../.env.development -- prisma migrate dev",
    "db:migrate:production": "dotenv -e ../../.env.production -- prisma migrate deploy",
    "generate:development": "dotenv -e ../../.env.development -- prisma generate",
    "generate:production": "dotenv -e ../../.env.production -- prisma generate",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "keywords": [],
  "author": "Vitor Valentim da Silva Ferreira",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/adapter-neon": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "prisma": "^7.9.1"
  }
}
