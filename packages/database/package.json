{
  "name": "aura-database",
  "version": "0.1.0",
  "description": "",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "prisma generate && tsup && rm -rf dist/generated && cp -r src/generated dist/generated",
    "dev": "tsup --watch",
    "lint": "eslint .",
    "db:push:development": "dotenv -e ../../.env.development -- prisma db push",
    "db:push:production": "dotenv -e ../../.env.production -- prisma db push",
    "db:migrate:development": "dotenv -e ../../.env.development -- prisma migrate dev",
    "db:migrate:production": "dotenv -e ../../.env.production -- prisma migrate deploy",
    "generate:development": "dotenv -e ../../.env.development -- prisma generate",
    "generate:production": "dotenv -e ../../.env.production -- prisma generate",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "keywords": [],
  "author": "Vitor Valentim da Silva Ferreira",
  "license": "ISC",
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/adapter-neon": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@prisma/client-runtime-utils": "^7.9.1",
    "prisma": "^7.9.1"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:"
  }
}
