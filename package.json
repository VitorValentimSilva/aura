{
  "name": "aura",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "main": "index.js",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "db:push:development": "turbo run db:push:development",
    "db:push:production": "turbo run db:push:production",
    "db:migrate:development": "turbo run db:migrate:development",
    "db:migrate:production": "turbo run db:migrate:production",
    "generate:development": "turbo run generate:development",
    "generate:production": "turbo run generate:production",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "update:deps": "pnpm up -r",
    "update:deps:latest": "pnpm up -r --latest",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run format:check"
  },
  "keywords": [],
  "author": "Vitor Valentim da Silva Ferreira",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.17.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.1.2",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "turbo": "^2.10.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0"
  }
}
